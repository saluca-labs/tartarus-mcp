  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "agent",
    "sqlite",
    "local-first",
    "asphodel"
  ],
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saluca-labs/tartarus-mcp.git"
  },
  "homepage": "https://github.com/saluca-labs/tartarus-mcp#readme",
  "bugs": {
    "url": "https://github.com/saluca-labs/tartarus-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@saluca/asphodel": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
