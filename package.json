{
  "name": "tartarus-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first MCP memory server. Persistent, searchable memory for any AI agent. Built on a vendored copy of the Apache-2.0 Asphodel core.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "tartarus-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "check:meta": "node scripts/check-package-meta.mjs saluca-labs/tartarus-mcp",
    "smoke": "node scripts/smoke-mcp.mjs",
    "smoke:install": "node scripts/smoke-install.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src/vendor/asphodel/LICENSE",
    "src/vendor/asphodel/NOTICE"
  ],
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "agent",
    "sqlite",
    "local-first",
    "asphodel"
  ],
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saluca-labs/tartarus-mcp.git"
  },
  "homepage": "https://github.com/saluca-labs/tartarus-mcp#readme",
  "bugs": {
    "url": "https://github.com/saluca-labs/tartarus-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
